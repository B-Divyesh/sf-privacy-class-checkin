{
  "name": "privacy-class-checkin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "cargo run",
    "build": "vite build",
    "build:server": "cargo build --release",
    "test": "tsc --noEmit && vitest run && cargo test && npm run test:release-cache",
    "test:release-cache": "BUILD_SHA=qa-regression vite build && node --test tests/release-output.test.mjs",
    "test:e2e": "playwright test",
    "preview": "vite preview --host 0.0.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "1.58.2",
    "@types/node": "^26.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
